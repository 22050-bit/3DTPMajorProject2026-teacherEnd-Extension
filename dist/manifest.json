{
  "manifest_version": 3,
  "name": "Pink Slip (Teacher end)",
  "version": "0.2.9",
  
  
  "icons": { 
    "16": "/images/icon1.png", 
    "32": "/images/icon1.png", 
    "48": "/images/icon1.png", 
    "128": "/images/icon1.png" 
    }, 
    "action": { 
      "default_icon": { 
        "16": "/images/icon1.png", 
        "24": "/images/icon1.png", 
        "32": "/images/icon1.png" 
        }, 
      "default_title": "Pink Slip (Teacher end)" ,
      "default_popup": "index.html"
    },

    "background": {
    "service_worker": "background.js" ,
    "type":"module"
    },

  "content_scripts": [
    {
    "matches": [
      "https://test-bdb0b.firebaseapp.com/*",
      "https://test-bdb0b.web.app/*"
    ],
    "js": ["content.js"]
    }
  ],

  "host_permissions": [
  "https://test-bdb0b.firebaseapp.com/*",
  "https://test-bdb0b.web.app/*"
  ],

  "permissions": [
    "windows",
    "storage"
  ]

}