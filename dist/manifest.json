{
  "manifest_version": 3,
  "name": "Pink Slip (Teacher end)",
  "version": "0.2.4",
  
  
  "icons": { 
    "16": "/images/icon1.png", 
    "32": "/images/icon1.png", 
    "48": "/images/icon1.png", 
    "128": "/images/icon1.png" 
    }, 
    "action": { 
      "default_icon": { 
        "16": "/images/icon1.png", 
        "24": "/images/icon1.png", 
        "32": "/images/icon1.png" 
        }, 
      "default_title": "Pink Slip (Teacher end)" ,
      "default_popup": "/extension popup/index.html"
    },
    
    "background": {
    "service_worker": "background.js" ,
    "type":"module"
    },

  "content_scripts": [
    {
    "matches": [
      "http://localhost:5173/*"
    ],
    "js": ["content.js"]
    }
  ],

  "host_permissions": [
  "http://localhost:5173/*"
  ],

  "permissions": [
    "windows",
    "storage"
  ]

}